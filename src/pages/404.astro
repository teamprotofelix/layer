---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';

const base = import.meta.env.BASE_URL;
---

<BaseLayout titleKey="meta.notFoundTitle">
  <div class="page">
    <div class="container" style="text-align: center; padding-block: 4rem;">
      <p class="kicker">404</p>
      <h1 data-i18n="notFound.title">{t('ko', 'notFound.title')}</h1>
      <p data-i18n="notFound.text">{t('ko', 'notFound.text')}</p>
      <a class="btn btn-primary" href={base} data-i18n="common.backHome">{t('ko', 'common.backHome')}</a>
    </div>
  </div>
</BaseLayout>
