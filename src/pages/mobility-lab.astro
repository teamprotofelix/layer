---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageWithFallback from '../components/ImageWithFallback.astro';
import NextLinks from '../components/NextLinks.astro';
---

<BaseLayout titleKey="meta.mobilityLabTitle" descKey="meta.mobilityLabDesc">
  <div class="page">
    <div class="container">
      <div id="mobility-lab-root"></div>
      <section class="section">
        <ImageWithFallback name="persona-voyage" altKey="meta.mobilityLabTitle" ratio="16 / 9" />
      </section>
      <NextLinks next={{ href: '/return-lab/', key: 'next.returnLab' }} />
    </div>
  </div>
</BaseLayout>

<script>
  import { mountMobilityLab } from '../labs/mobility-lab';

  const root = document.getElementById('mobility-lab-root');
  if (root) mountMobilityLab(root);
</script>
