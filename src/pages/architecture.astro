---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvidenceBadge from '../components/EvidenceBadge.astro';
import ImageWithFallback from '../components/ImageWithFallback.astro';
import NextLinks from '../components/NextLinks.astro';
import { t } from '../i18n';

const boundaries = [1, 2, 3] as const;
---

<BaseLayout titleKey="meta.architectureTitle" descKey="meta.architectureDesc">
  <div class="page">
    <div class="container">
      <h1 data-i18n="arch.title">{t('ko', 'arch.title')}</h1>
      <p class="lead" data-i18n="arch.lead">{t('ko', 'arch.lead')}</p>
      <div class="card-title-row">
        <EvidenceBadge state="CONCEPT" />
        <EvidenceBadge state="PROTOTYPE" />
      </div>

      <div id="arch-diagram-root"></div>

      <section class="section" aria-labelledby="state-title">
        <h2 id="state-title" data-i18n="arch.stateTitle">{t('ko', 'arch.stateTitle')}</h2>
        <div class="card-grid card-grid-2">
          <div class="card">
            <h3 data-i18n="arch.travelBefore">{t('ko', 'arch.travelBefore')}</h3>
            <p data-i18n="arch.beforeState">{t('ko', 'arch.beforeState')}</p>
          </div>
          <div class="card">
            <h3 data-i18n="arch.travelAfter">{t('ko', 'arch.travelAfter')}</h3>
            <p data-i18n="arch.afterState">{t('ko', 'arch.afterState')}</p>
          </div>
        </div>
      </section>

      <section class="section" aria-labelledby="boundary-title">
        <h2 id="boundary-title" data-i18n="arch.boundaryTitle">{t('ko', 'arch.boundaryTitle')}</h2>
        <ul>
          {boundaries.map((b) => (
            <li data-i18n={`arch.boundary${b}`}>{t('ko', `arch.boundary${b}`)}</li>
          ))}
        </ul>
      </section>

      <section class="section" aria-labelledby="ark-visual">
        <h2 id="ark-visual" data-i18n="arch.arkTitle">{t('ko', 'arch.arkTitle')}</h2>
        <ImageWithFallback name="ark-control" altKey="meta.architectureTitle" ratio="3 / 2" />
        <p style="margin-top: 0.5rem; font-size: 0.85rem; color: var(--ink-faint);">
          <span data-i18n="common.hint">{t('ko', 'common.hint')}:</span>
          <span data-i18n="common.simNotice"> {t('ko', 'common.simNotice')}</span>
        </p>
      </section>

      <NextLinks next={{ href: '/layer-lab/', key: 'next.layerLab' }} />
    </div>
  </div>
</BaseLayout>

<script>
  import { mountArchDiagram } from '../labs/arch-diagram';

  const root = document.getElementById('arch-diagram-root');
  if (root) mountArchDiagram(root);
</script>
