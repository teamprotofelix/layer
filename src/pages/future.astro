---
import BaseLayout from '../layouts/BaseLayout.astro';
import ImageWithFallback from '../components/ImageWithFallback.astro';
import NextLinks from '../components/NextLinks.astro';
import { t } from '../i18n';
---

<BaseLayout titleKey="meta.futureTitle" descKey="meta.futureDesc">
  <div class="page">
    <div class="container">
      <div id="future-scene-root"></div>

      <section class="section" aria-label="research horizon">
        <ImageWithFallback name="research-horizon" altKey="meta.futureTitle" ratio="21 / 9" />
      </section>

      <NextLinks next={{ href: '/sources/', key: 'next.sources' }} />
    </div>
  </div>
</BaseLayout>

<script>
  import { mountFutureScene } from '../labs/future-scene';

  const root = document.getElementById('future-scene-root');
  if (root) mountFutureScene(root);
</script>
